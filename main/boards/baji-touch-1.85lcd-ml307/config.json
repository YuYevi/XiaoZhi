{
    "type": "baji-touch-1.85lcd-ml307",
    "target": "esp32s3",
    "builds": [
        {
            "name": "baji-touch-1.85lcd-ml307",
            "sdkconfig_append": [
                "CONFIG_BOARD_TYPE_BAJI_TOUCH_1_85LCD_ML307=y",
                "CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y",
                "CONFIG_ESPTOOLPY_FLASHMODE_QIO=y",
                "CONFIG_ESPTOOLPY_FLASHFREQ_80M=y",
                "CONFIG_PARTITION_TABLE_CUSTOM=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v2/16m.csv\"",
                "CONFIG_PARTITION_TABLE_OFFSET=0x8000",
                "CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y",
                "CONFIG_SPIRAM=y",
                "CONFIG_SPIRAM_MODE_OCT=y",
                "CONFIG_SPIRAM_SPEED_80M=y",
                "CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=2048",
                "CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=98304",
                "CONFIG_SPIRAM_MEMTEST=n",
                "CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y",
                "CONFIG_USE_AFE_WAKE_WORD=y",
                "CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=y",
                "CONFIG_FLASH_DEFAULT_ASSETS=y"
            ]
        }
    ]
}
